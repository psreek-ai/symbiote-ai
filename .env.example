# Symbiote AI — Environment Configuration
# Copy this file to .env and fill in your values before running anything.
#
# cp .env.example .env

# ------------------------------------------------------------------ #
# Required: Scout module (lead discovery)                             #
# ------------------------------------------------------------------ #
TAVILY_API_KEY=

# ------------------------------------------------------------------ #
# Required: Scout + Negotiate modules (LLM calls)                    #
# ------------------------------------------------------------------ #
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------ #
# Required for live email sending (skip if DRY_RUN=true)             #
# ------------------------------------------------------------------ #
RESEND_API_KEY=

# ------------------------------------------------------------------ #
# Sender identity — must match a verified Resend sending domain      #
# ------------------------------------------------------------------ #
SENDER_EMAIL=partnerships@symbiote.ai
SENDER_NAME=Head of Partnerships, Symbiote AI

# ------------------------------------------------------------------ #
# Verification — the domain we look for on partner websites          #
# ------------------------------------------------------------------ #
SYMBIOTE_DOMAIN=symbiote.ai

# ------------------------------------------------------------------ #
# Behaviour flags                                                     #
# ------------------------------------------------------------------ #
# Start in dry-run mode (safe default). Flip to false only when you
# are ready to actually deliver emails via Resend.
DRY_RUN=true

# ------------------------------------------------------------------ #
# Tuning                                                              #
# ------------------------------------------------------------------ #
SCOUT_MAX_RESULTS=5
EMAIL_RATE_LIMIT_SECONDS=2.0

# ------------------------------------------------------------------ #
# Lead scoring — leads below this threshold are skipped at pitch time #
# ------------------------------------------------------------------ #
MIN_LEAD_SCORE=40

# ------------------------------------------------------------------ #
# Follow-up sequences                                                  #
# ------------------------------------------------------------------ #
# Days to wait after the initial pitch before sending follow-up #1
FOLLOWUP_DELAY_DAYS=5
# Maximum number of follow-ups to send per lead (recommended: 1-2)
FOLLOWUP_MAX_COUNT=2

# ------------------------------------------------------------------ #
# Inbound email webhook + CAN-SPAM unsubscribe                        #
# ------------------------------------------------------------------ #
WEBHOOK_PORT=8080
# Public URL where Resend should forward inbound replies
# WEBHOOK_URL=https://your-server.example.com/webhook/inbound
# Publicly reachable unsubscribe page (embedded in every outbound email)
UNSUBSCRIBE_URL=http://localhost:8080/unsubscribe

# ------------------------------------------------------------------ #
# Model selection (Anthropic Claude)                                  #
# ------------------------------------------------------------------ #
FAST_MODEL=claude-haiku-4-5
SMART_MODEL=claude-sonnet-4-5
